# Claude API 配置
ANTHROPIC_API_KEY=your_api_key_here
# 如果使用中转站，填写中转站地址（例如：https://heyroute.ai）
ANTHROPIC_BASE_URL=https://heyroute.ai
ANTHROPIC_MODEL=claude-opus-4-8

# 博客配置
BLOG_TITLE=Robotail Journal
BLOG_DESCRIPTION=A happier home with cats
BLOG_AUTHOR=Robotail Editorial Team

# 内容生成配置
CONTENT_TOPIC=Robotail litter boxes and everyday essentials for a cat-friendly home
CONTENT_LANGUAGE=en  # The journal follows content/editorial-policy.json
POSTS_PER_RUN=1  # 每次运行生成几篇文章
