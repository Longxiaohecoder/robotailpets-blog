# Claude API 配置
ANTHROPIC_API_KEY=your_api_key_here
# 如果使用中转站，填写中转站地址（例如：https://heyroute.ai）
ANTHROPIC_BASE_URL=https://heyroute.ai
ANTHROPIC_MODEL=claude-opus-4-8

# 博客配置
BLOG_TITLE=我的自动化博客
BLOG_DESCRIPTION=使用 AI 驱动的内容营销自动化系统
BLOG_AUTHOR=你的名字

# 内容生成配置
CONTENT_TOPIC=Robotail 猫砂盆、喂食器及配件选购
CONTENT_LANGUAGE=zh  # zh=中文, en=英文
POSTS_PER_RUN=1  # 每次运行生成几篇文章
