---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { topics } from '../../lib/journal';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="The Journal | Robotail — Life at Home with Cats">
  <div class="wrap">
    <header class="journal-header"><h1>Little discoveries. Better days.</h1><p>Stories about home, companionship, and the everyday joy of living with cats.</p></header>
    <div class="search-row">
      <div class="filters" role="group" aria-label="Filter articles by topic"><button class="filter" data-filter="All" aria-pressed="true">All articles</button>{topics.map(topic => <button class="filter" data-filter={topic} aria-pressed="false">{topic}</button>)}</div>
      <div><label class="search-label" for="article-search">Search the journal</label><input class="search-field" id="article-search" type="search" placeholder="Try: litter boxes, home, routines" autocomplete="off" /></div>
    </div>
    <p class="results-count" id="results-count" role="status" aria-live="polite">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
    <div class="post-grid" id="post-grid">{posts.map(post => <PostCard post={post} />)}</div>
    <div class="empty-state" id="empty-results" hidden={posts.length > 0}><h2>More stories are on their way</h2><p id="empty-message">Try another topic, or explore our published articles.</p><button class="button secondary" id="reset-filters">View all articles</button></div>
  </div>
  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-post]')];
    const search = document.querySelector<HTMLInputElement>('#article-search');
    const params = new URLSearchParams(location.search);
    const allowed = buttons.map(button => button.dataset.filter);
    let selected = allowed.includes(params.get('topic') || '') ? params.get('topic')! : 'All';
    if (search) search.value = params.get('q') || '';
    const apply = (updateURL = true) => {
      const query = search?.value.trim().toLowerCase() || '';
      let count = 0;
      cards.forEach(card => {
        const visible = (selected === 'All' || card.dataset.topic === selected) && (card.dataset.search || '').includes(query);
        card.hidden = !visible;
        if (visible) count++;
      });
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === selected)));
      const counter = document.querySelector('#results-count');
      if (counter) counter.textContent = count + (count === 1 ? ' article' : ' articles');
      const empty = document.querySelector<HTMLElement>('#empty-results');
      if (empty) empty.hidden = count > 0;
      const grid = document.querySelector<HTMLElement>('#post-grid');
      if (grid) grid.hidden = count === 0;
      const message = document.querySelector('#empty-message');
      if (message) message.textContent = query ? 'No articles matched your search. Try a different keyword.' : 'New stories for this topic are in the works. Explore all articles for now.';
      if (updateURL) {
        const url = new URL(location.href);
        if (selected === 'All') url.searchParams.delete('topic'); else url.searchParams.set('topic', selected);
        if (query) url.searchParams.set('q', search?.value.trim() || ''); else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }
    };
    buttons.forEach(button => button.addEventListener('click', () => { selected = button.dataset.filter || 'All'; apply(); }));
    search?.addEventListener('input', () => apply());
    document.querySelector('#reset-filters')?.addEventListener('click', () => { selected = 'All'; if (search) search.value = ''; apply(); });
    window.addEventListener('popstate', () => {
      const url = new URLSearchParams(location.search);
      selected = allowed.includes(url.get('topic') || '') ? url.get('topic')! : 'All';
      if (search) search.value = url.get('q') || '';
      apply(false);
    });
    apply(false);
  </script>
</BaseLayout>
