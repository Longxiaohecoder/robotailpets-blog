---
import type { CollectionEntry } from 'astro:content';
import { topicOf, coverOf, dateLabel } from '../lib/journal';
import JournalImage from './JournalImage.astro';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const href = '/blog/' + post.slug + '/';
---
<article class="post-card" data-post data-topic={topicOf(post)} data-search={[post.data.title, post.data.description, ...post.data.tags].join(' ').toLowerCase()}>
  <a class="card-image" href={href} aria-label={'Read: ' + post.data.title} style="display:block">
    <JournalImage src={coverOf(post)} alt={post.data.coverAlt || 'Cats and their person sharing a warm, welcoming home'} />
  </a>
  <div class="metadata"><span class="category-label">{topicOf(post)}</span><time datetime={post.data.pubDate.toISOString()}>{dateLabel(post.data.pubDate)}</time></div>
  <h2><a href={href}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <a class="arrow-link" href={href}>Read the story <span aria-hidden="true">↗</span></a>
</article>
