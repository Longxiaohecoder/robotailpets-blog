---
import BaseLayout from './BaseLayout.astro';
import { dateLabel } from '../lib/journal';
import JournalImage from '../components/JournalImage.astro';
interface Props {
  title: string; description: string; pubDate: Date; tags: string[]; author: string;
  category: string; cover: string; coverAlt?: string; minutes: number;
  headings: { depth: number; slug: string; text: string }[];
}
const { title, description, pubDate, tags, author, category, cover, coverAlt, minutes, headings } = Astro.props;
const toc = headings.filter(heading => heading.depth === 2);
---
<BaseLayout title={title + ' | Robotail 博客'} description={description} image={cover}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/blog/">文章列表</a><span aria-hidden="true">/</span><span>{category}</span></nav>
    <header class="article-heading">
      <span class="category-label">{category}</span><h1>{title}</h1><p>{description}</p>
      <div class="metadata"><span>{author}</span><time datetime={pubDate.toISOString()}>{dateLabel(pubDate)}</time><span>{minutes} 分钟阅读</span></div>
    </header>
    <JournalImage class="article-cover" src={cover} alt={coverAlt || '人与宠物共享温馨家居的生活场景'} priority sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1280px) calc(100vw - 80px), 1200px" />
    <div class="article-layout">
      <aside class="article-aside" aria-label="文章目录"><div><h2>这篇文章里</h2><ol>{toc.map(heading => <li><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ol><p class="aside-note">选得合适，住得舒服。<br />从实际需要出发，为彼此留一个舒适的家。</p></div></aside>
      <article class="prose">
        <slot />
        <div class="article-tail"><div class="article-tags">{tags.map(tag => <a href={'/blog/?q=' + encodeURIComponent(tag)}>{tag}</a>)}</div><a class="arrow-link" href="/blog/">返回文章列表 <span aria-hidden="true">↗</span></a></div>
      </article>
    </div>
  </div>
</BaseLayout>
