---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: string;
  tags: string[];
  author: string;
}

const { title, description, pubDate, tags, author } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={title} description={description}>
  <article>
    <header style="margin-bottom: 2rem; border-bottom: 2px solid #eee; padding-bottom: 1.5rem;">
      <h1 style="font-size: 2.5rem; margin-bottom: 1rem; color: #1a1a1a;">{title}</h1>
      <div style="color: #666; margin-bottom: 1rem;">
        <time datetime={pubDate}>{formattedDate}</time>
        <span style="margin: 0 10px;">•</span>
        <span>作者: {author}</span>
      </div>
      <p style="font-size: 1.1rem; color: #555;">{description}</p>
      <div style="margin-top: 1rem;">
        {tags.map((tag) => (
          <span style="display: inline-block; background: #e3f2fd; color: #1976d2; padding: 4px 12px; border-radius: 16px; font-size: 0.9rem; margin-right: 8px;">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  <style>
    .prose {
      font-size: 1.1rem;
      line-height: 1.8;
    }

    .prose :global(h2) {
      font-size: 1.8rem;
      margin-top: 2rem;
      margin-bottom: 1rem;
      color: #1a1a1a;
    }

    .prose :global(h3) {
      font-size: 1.4rem;
      margin-top: 1.5rem;
      margin-bottom: 0.8rem;
      color: #333;
    }

    .prose :global(p) {
      margin-bottom: 1.2rem;
    }

    .prose :global(ul), .prose :global(ol) {
      margin-left: 2rem;
      margin-bottom: 1.2rem;
    }

    .prose :global(li) {
      margin-bottom: 0.5rem;
    }

    .prose :global(code) {
      background: #f5f5f5;
      padding: 2px 6px;
      border-radius: 3px;
      font-family: 'Courier New', monospace;
      font-size: 0.9em;
    }

    .prose :global(pre) {
      background: #1e1e1e;
      color: #d4d4d4;
      padding: 1rem;
      border-radius: 6px;
      overflow-x: auto;
      margin-bottom: 1.2rem;
    }

    .prose :global(blockquote) {
      border-left: 4px solid #ddd;
      padding-left: 1rem;
      margin-left: 0;
      margin-bottom: 1.2rem;
      color: #666;
      font-style: italic;
    }
  </style>
</BaseLayout>
