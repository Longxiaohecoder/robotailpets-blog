---
import '../styles/journal.css';
interface Props { title: string; description?: string; image?: string; }
const { title, description = '和宠物一起，把家过成喜欢的样子。Robotail 分享温馨家居、相处日常与宠物用品选购。', image = '/images/journal/home-together.webp' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isBlog = Astro.url.pathname.startsWith('/blog');
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#3d624d" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={isBlog && Astro.url.pathname !== '/blog/' ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <title>{title}</title>
  <script is:inline>
    try {
      const saved = localStorage.getItem('robotail-theme');
      document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch { document.documentElement.dataset.theme = 'light'; }
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content">跳到正文</a>
  <header class="site-header">
    <div class="wrap nav-row">
      <a class="brand" href="/" aria-label="Robotail 博客首页">
        <span class="wordmark">Robotail</span><span class="brand-caption">宠物家庭<br />生活志</span>
      </a>
      <nav class="main-nav" id="main-nav" aria-label="主导航">
        <a href="/" aria-current={!isBlog ? 'page' : undefined}>首页</a>
        <a href="/blog/" aria-current={isBlog ? 'page' : undefined}>文章列表</a>
        <a href="/#topics">生活主题</a>
        <a href="/#together">我们的理念</a>
      </nav>
      <div class="nav-actions">
        <button class="text-control" id="theme-toggle" type="button" aria-label="切换页面配色">夜间</button>
        <a class="shop-link" href="https://robotailpets.com" target="_blank" rel="noopener noreferrer">品牌官网 ↗</a>
        <button class="menu-toggle" id="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false">菜单</button>
      </div>
    </div>
  </header>
  <main id="main-content"><slot /></main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <div><a class="wordmark" href="/">Robotail</a><p>让每一个家，都有安心相伴的日常。</p></div>
        <nav class="footer-links" aria-label="页脚导航">
          <a href="/blog/">文章列表</a><a href="/#together">我们的理念</a><a href="https://robotailpets.com" target="_blank" rel="noopener noreferrer">品牌官网 ↗</a>
        </nav>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Robotail 博客</span><span>家的温度，来自彼此的陪伴。</span></div>
    </div>
  </footer>
  <script>
    const menu = document.querySelector<HTMLButtonElement>('#menu-toggle');
    const nav = document.querySelector<HTMLElement>('#main-nav');
    const closeMenu = () => { nav?.classList.remove('is-open'); menu?.setAttribute('aria-expanded', 'false'); };
    menu?.addEventListener('click', () => {
      const open = menu.getAttribute('aria-expanded') !== 'true';
      menu.setAttribute('aria-expanded', String(open));
      nav?.classList.toggle('is-open', open);
    });
    nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); }
    });
    const theme = document.querySelector<HTMLButtonElement>('#theme-toggle');
    const label = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      if (theme) { theme.textContent = dark ? '日间' : '夜间'; theme.setAttribute('aria-label', dark ? '切换为日间配色' : '切换为夜间配色'); }
    };
    label();
    theme?.addEventListener('click', () => {
      const value = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = value;
      try { localStorage.setItem('robotail-theme', value); } catch {}
      label();
    });
  </script>
</body>
</html>
