---
import '../styles/journal.css';
import analytics from '../../../content/analytics-config.json';
interface Props { title: string; description?: string; image?: string; noindex?: boolean; }
const { title, description = 'A warmer home, a happier life with cats. Explore cat-friendly spaces, everyday companionship, and thoughtful product guides with Robotail.', image = '/images/journal/home-with-cats.webp', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isBlog = Astro.url.pathname.startsWith('/blog');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#685bc7" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={isBlog && Astro.url.pathname !== '/blog/' ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <title>{title}</title>
  <script is:inline>
    try {
      const saved = localStorage.getItem('robotail-theme');
      document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch { document.documentElement.dataset.theme = 'light'; }
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', document.documentElement.dataset.theme === 'dark' ? '#211c2a' : '#685bc7');
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="wrap nav-row">
      <a class="brand" href="/" aria-label="Robotail — A journal for life with cats. Home">
        <span class="wordmark">Robotail</span><span class="brand-caption">A journal for<br />life with cats.</span>
      </a>
      <nav class="main-nav" id="main-nav" aria-label="Main navigation">
        <a href="/" aria-current={!isBlog ? 'page' : undefined}>Home</a>
        <a href="/blog/" aria-current={isBlog ? 'page' : undefined}>Journal</a>
        <a href="/#topics">Topics</a>
        <a href="/#together">Our Story</a>
      </nav>
      <div class="nav-actions">
        <button class="text-control" id="theme-toggle" type="button" aria-label="Switch color theme">Dark</button>
        <a class="shop-link" href="https://robotailpets.com" target="_blank" rel="noopener noreferrer">Shop Robotail ↗</a>
        <button class="menu-toggle" id="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false">Menu</button>
      </div>
    </div>
  </header>
  <main id="main-content"><slot /></main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <div><a class="wordmark" href="/">Robotail</a><p>For the little moments that make a house a home.</p></div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/blog/">Journal</a><a href="/#together">Our Story</a><a href="https://robotailpets.com" target="_blank" rel="noopener noreferrer">Shop Robotail ↗</a>
        </nav>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Robotail Journal</span><a href="/analytics-settings/">Privacy &amp; analytics</a><span>A good life, shared with cats.</span></div>
    </div>
  </footer>
  <script>
    const menu = document.querySelector<HTMLButtonElement>('#menu-toggle');
    const nav = document.querySelector<HTMLElement>('#main-nav');
    const closeMenu = () => { nav?.classList.remove('is-open'); menu?.setAttribute('aria-expanded', 'false'); };
    menu?.addEventListener('click', () => {
      const open = menu.getAttribute('aria-expanded') !== 'true';
      menu.setAttribute('aria-expanded', String(open));
      nav?.classList.toggle('is-open', open);
    });
    nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); }
    });
    const theme = document.querySelector<HTMLButtonElement>('#theme-toggle');
    const label = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#211c2a' : '#685bc7');
      if (theme) { theme.textContent = dark ? 'Light' : 'Dark'; theme.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode'); }
    };
    label();
    theme?.addEventListener('click', () => {
      const value = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = value;
      try { localStorage.setItem('robotail-theme', value); } catch {}
      label();
    });
  </script>
  <script is:inline defer src="/analytics.js" data-measurement-id={analytics.measurementId}></script>
</body>
</html>
